{
  "name": "whenkin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find your shared time. Group scheduling with automatic time zones.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env App/backend/tools/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch App/backend/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node infra/build.mjs",
    "build:server": "node infra/build.mjs server",
    "build:sites": "node infra/build.mjs sites",
    "dev:sites": "wrangler dev --config infra/sites/wrangler.json --ip 127.0.0.1 --port 5173",
    "start": "node --env-file-if-exists=.env dist/node/backend/server.js",
    "check": "tsc --noEmit",
    "lint": "eslint App tests *.ts",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "node --env-file-if-exists=.env App/backend/tools/migrate.mjs",
    "db:cleanup": "node --env-file-if-exists=.env App/backend/tools/cleanup.mjs",
    "db:analyze": "node --env-file-if-exists=.env App/backend/tools/analyze-events.mjs",
    "db:verify-retention": "node App/backend/tools/verify-retention.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@neondatabase/serverless": "1.2.0",
    "express": "5.3.0",
    "lucide-react": "1.31.0",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "22.19.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vitest": "4.0.18",
    "wrangler": "4.92.0"
  }
}
