# PUBLIC_ORIGIN=https://your-domain.example

# Docker Compose local defaults. Choose a new password before production deployment.
DB_PASSWORD=whenkin_local_only
DB_PORT=5432
APP_PORT=3000
# DOMAIN=your-domain.example
